{
  "schema_version": "1.0.0",
  "id": "stoch_rsi_options_draft",
  "revision": 1,
  "metadata": {
    "name": "Options oscillator research draft",
    "description": "Illustrative options draft only, not backtested or approved for live trading.",
    "tags": [
      "draft",
      "options"
    ]
  },
  "universe": {
    "selection": "dynamic_filter",
    "product_types": [
      "call_option",
      "put_option"
    ],
    "underlying_symbols": [],
    "product_ids": [],
    "max_products": 10
  },
  "clock": {
    "signal_timeframe": "1h",
    "execution_timeframe": "1m",
    "confirm_on_close": true,
    "intrabar_protective_exits": true,
    "max_price_age_ms": 2000
  },
  "session": {
    "timezone": "Asia/Kolkata",
    "weekdays": [
      1,
      2,
      3,
      4,
      5
    ],
    "windows": [
      {
        "start": "00:00",
        "end": "23:59"
      }
    ]
  },
  "signals": {
    "long_entry": {
      "type": "group",
      "id": "option-entry-long",
      "join": "all",
      "children": [
        {
          "type": "compare",
          "id": "option-k-low",
          "left": {
            "kind": "indicator",
            "indicator": "stoch_rsi",
            "parameters": {
              "period": 14
            },
            "output": "k",
            "timeframe": "1h",
            "offset": 0
          },
          "operator": "lt",
          "right": {
            "kind": "constant",
            "value": "20"
          }
        }
      ]
    },
    "short_entry": {
      "type": "group",
      "id": "option-entry-short",
      "join": "all",
      "children": [
        {
          "type": "compare",
          "id": "option-k-high",
          "left": {
            "kind": "indicator",
            "indicator": "stoch_rsi",
            "parameters": {
              "period": 14
            },
            "output": "k",
            "timeframe": "1h",
            "offset": 0
          },
          "operator": "gt",
          "right": {
            "kind": "constant",
            "value": "80"
          }
        }
      ]
    },
    "long_exit": {
      "type": "group",
      "id": "option-exit-long",
      "join": "any",
      "children": []
    },
    "short_exit": {
      "type": "group",
      "id": "option-exit-short",
      "join": "any",
      "children": []
    },
    "conflict_policy": "skip_both"
  },
  "execution": {
    "order_type": "limit",
    "time_in_force": "gtc",
    "post_only": false,
    "reduce_only_exits": true,
    "max_slippage_bps": 20,
    "sizing": {
      "mode": "fixed_lots",
      "value": "1"
    },
    "options": {
      "expiry_selection": "nearest_eligible",
      "min_dte_hours": 36,
      "max_dte_hours": 336,
      "strike_selection": "atm",
      "strike_offset": 0,
      "direction_map": {
        "long": {
          "option_type": "call",
          "action": "buy_to_open"
        },
        "short": {
          "option_type": "put",
          "action": "buy_to_open"
        }
      }
    }
  },
  "risk": {
    "max_open_positions": 1,
    "max_orders_per_minute": 6,
    "max_daily_loss_pct": 2,
    "max_drawdown_pct": 10,
    "max_consecutive_losses": 4,
    "max_notional_quote": "2000",
    "min_margin_buffer_pct": 30,
    "stop_loss": {
      "mode": "percent",
      "value": "15",
      "basis": "option_entry_premium"
    },
    "take_profit": {
      "mode": "off",
      "value": "0"
    },
    "trailing_stop": {
      "enabled": false,
      "activation": "3",
      "distance": "1",
      "unit": "atr_multiple"
    },
    "halt_on_stale_data": true,
    "halt_on_reconciliation_gap": true
  }
}
